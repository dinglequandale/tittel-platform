# --- Supabase Postgres -------------------------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI.
# Use the "Session" pooler URI (port 5432) for a long-lived Node server — the
# direct db.<ref>.supabase.co host is IPv6-only on the free tier (PLAN.md §9.5).
# This is a SECRET. Never commit the real value; set it in Render's env panel.
DATABASE_URL=postgresql://postgres:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# --- Supabase Auth (tutors only) ---------------------------------------------
# Supabase dashboard -> Project Settings -> API. Used to verify tutor JWTs via
# JWKS (server) and to initialize the auth client (web).
SUPABASE_URL=https://[PROJECT-REF].supabase.co

# --- Local dev only ----------------------------------------------------------
# PORT=6060
