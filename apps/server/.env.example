# --- Supabase Postgres -------------------------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI.
# Use the "Session" pooler URI (port 5432) for a long-lived Node server — the
# direct db.<ref>.supabase.co host is IPv6-only on the free tier (PLAN.md §9.5).
# This is a SECRET. Never commit the real value; set it in Render's env panel.
DATABASE_URL=postgresql://postgres:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# --- Supabase Auth (tutors only) ---------------------------------------------
# Supabase dashboard -> Project Settings -> API. Used to verify tutor JWTs via
# JWKS (server) and to initialize the auth client (web).
SUPABASE_URL=https://[PROJECT-REF].supabase.co

# --- AI lesson-plan / worksheet import ----------------------------------------
# Anthropic Console -> API Keys. Powers POST /api/tutor/ai-import (PDF/DOCX ->
# bank problems, claude-haiku-4-5, see routes/aiImport.ts). If unset, the
# endpoint returns 503 and the web UI hides the "Import from document" button.
ANTHROPIC_API_KEY=

# --- Board tokens -------------------------------------------------------------
# Signs the short-lived host/guest board tokens (PLAN.md §6.3). Any long random
# string. If unset, a per-boot random secret is used instead — fine for local
# dev, but it invalidates every live board's tokens on every restart in
# production, so set this for deployed environments.
BOARD_TOKEN_SECRET=

# --- Local dev only ----------------------------------------------------------
# PORT=6060

# Error reports (optional). Leave unset to keep Sentry off.
# SENTRY_DSN=https://...@....ingest.sentry.io/...
