# Supabase dashboard -> Project Settings -> API.
# The anon key is public by design (RLS-equivalent enforcement happens
# server-side via org_id scoping, PLAN.md §5.4) — safe to ship in the bundle.
VITE_SUPABASE_URL=https://[PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=[ANON-KEY]

# Show "Sign in with Google" once Google is enabled in Supabase
# (Authentication -> Providers -> Google). Leave unset until then.
# VITE_GOOGLE_AUTH=on

# Error reports (optional). Leave unset to keep Sentry off.
# VITE_SENTRY_DSN=https://...@....ingest.sentry.io/...
