{
  "name": "tittel-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Slate — multi-tenant tutoring platform (live boards + homework + content + analytics). See PLAN.md.",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace apps/server",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "start": "npm run start --workspace apps/server",
    "migrate": "npm run migrate --workspace apps/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20"
  }
}
